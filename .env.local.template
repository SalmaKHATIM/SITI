# ============================================
# STTIS Environment Configuration
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# ============================================

# ============================================
# 🔑 SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from: Supabase Dashboard → Settings → API

# Your Supabase Project URL
# Example: https://xyzabc123.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Key
# Found under "anon public" in API settings
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase Service Role Key
# Found under "service_role secret" in API settings
# Keep this PRIVATE - never share publicly!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# 🌐 APPLICATION CONFIGURATION
# ============================================

# Base URL of your STTIS application
NEXT_PUBLIC_STTIS_URL=http://localhost:3000

# FastAPI backend URL (if using ML features)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Environment: development or production
NEXT_ENV=development

# ============================================
# 🤖 AI/ML CONFIGURATION (Optional)
# ============================================

# Forecasting model confidence threshold (0-1)
ML_FORECAST_CONFIDENCE_THRESHOLD=0.7

# Anomaly detection sensitivity (0-1, higher = more sensitive)
ML_ANOMALY_SENSITIVITY=0.1

# NLP model selection
NLP_MODEL=huggingface-transformers

# ============================================
# 📊 ANALYTICS (Optional)
# ============================================

NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=
