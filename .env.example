# Service role key for backend operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Application Configuration
# ============================================

# Base URL for the application
NEXT_PUBLIC_STTIS_URL=http://localhost:3000

# FastAPI backend URL (for API calls)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Environment: development or production
NEXT_ENV=development

# ============================================
# Analytics & Monitoring (Optional)
# ============================================

NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=

# ============================================
# Backend Configuration (if running locally)
# ============================================

# FastAPI server port
FASTAPI_PORT=8000

# Database connection (Supabase automatically handles this)
DATABASE_URL=postgresql://user:password@localhost/sttis

# ============================================
# AI/ML Model Configuration
# ============================================

# Forecasting model parameters
ML_FORECAST_CONFIDENCE_THRESHOLD=0.7

# Anomaly detection sensitivity (0-1, higher = more sensitive)
ML_ANOMALY_SENSITIVITY=0.1

# NLP model selection
NLP_MODEL=huggingface-transformers
